# Local/deployment environment variable template.
# Replace every <...> value outside source control. Never commit real secrets.

# Render supplies PORT automatically.
PORT=4040

# Aiven MySQL connection. Use the JDBC URL, not the Aiven `mysql://` service URI.
# Aiven requires TLS for this service.
SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<database>?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<mysql-username>
SPRING_DATASOURCE_PASSWORD=<mysql-password>

# Must be at least 32 characters for the HS256 signing key.
APP_JWT_SECRET=<generate-a-long-random-secret-at-least-32-characters>
APP_JWT_EXPIRATION=86400000

# Email is disabled by default.
APP_EMAIL_ENABLED=false
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-app-password>

# Render local storage is ephemeral unless a persistent disk is attached.
UPLOAD_DIR=/tmp/uploads/complaints
